# Kopieer naar .env (lokaal) of zet deze variabelen in Coolify → Environment Variables.

# Google service account: plak de VOLLEDIGE inhoud van credentials.json op één regel
GOOGLE_CREDENTIALS_JSON=
# Alternatief (lokaal): pad naar het bestand
# GOOGLE_CREDENTIALS_FILE=credentials.json

SHEET_NAME=Recepten

# Willekeurige lange string voor Flask-sessies (bijv. python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Optioneel: wachtwoord voor de webapp (browser vraagt gebruikersnaam/wachtwoord)
APP_USER=recepten
APP_PASSWORD=

# Geheim token voor de MCP-connector (min. 24 tekens). Leeg = MCP uit.
# Connector-URL wordt dan: https://<jouw-domein>/mcp/<MCP_TOKEN>
MCP_TOKEN=

# Publieke URL van de app, voor links naar recepten in Claude-antwoorden
APP_BASE_URL=https://recepten.example.nl
